@model ProductDto

<div class="card h-100 shadow-sm">
    <a asp-action="Details" asp-route-id="@Model.Id">
        <img src="@ProductImage.Url(Model.ImageUrl)"
             alt="@Model.Name"
             class="card-img-top product-img"
             loading="lazy"
             onerror="this.onerror=null;this.src='@ProductImage.Placeholder';" />
    </a>

    <div class="card-body d-flex flex-column">
        <span class="badge text-bg-light border align-self-start mb-2">@Model.Category</span>

        <h2 class="h5 card-title">@Model.Name</h2>
        <p class="card-text text-muted small line-clamp-2">@Model.Description</p>

        <div class="mt-auto">
            <p class="fs-5 fw-semibold mb-1">$@(Model.Price.ToString("0.00"))</p>

            @if (Model.StockQuantity == 0)
            {
                <span class="badge text-bg-danger mb-2">Out of stock</span>
            }
            else if (Model.StockQuantity <= 5)
            {
                <span class="badge text-bg-warning mb-2">Only @Model.StockQuantity left</span>
            }

            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mt-2">
                View details
            </a>
        </div>
    </div>
</div>
