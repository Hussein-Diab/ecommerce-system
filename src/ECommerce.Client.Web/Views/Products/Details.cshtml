@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-category="@product.Category">@product.Category</a></li>
        <li class="breadcrumb-item active" aria-current="page">@product.Name</li>
    </ol>
</nav>

<div class="row g-4">
    @* ---------- Image ---------- *@
    <div class="col-md-6">
        <img src="@ProductImage.Url(product.ImageUrl)"
             alt="@product.Name"
             class="img-fluid rounded border product-img-lg"
             onerror="this.onerror=null;this.src='@ProductImage.Placeholder';" />
    </div>

    @* ---------- Info + buy box ---------- *@
    <div class="col-md-6">
        <h1 class="h2">@product.Name</h1>
        <span class="badge text-bg-light border mb-3">@product.Category</span>
        <p class="lead">@product.Description</p>

        <div class="card shadow-sm">
            <div class="card-body">
                <p class="display-6 fw-semibold mb-2">$@(product.Price.ToString("0.00"))</p>

                @if (!product.IsAvailable)
                {
                    <p class="text-danger fw-semibold">This product is currently unavailable.</p>
                }
                else if (product.StockQuantity == 0)
                {
                    <p class="text-danger fw-semibold">Out of stock.</p>
                }
                else
                {
                    <p class="text-success mb-3">In stock: @product.StockQuantity</p>
                }

                @if (Model.CanBuy)
                {
                    <form asp-controller="Cart" asp-action="Add" method="post">
                        <input type="hidden" name="productId" value="@product.Id" />

                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label"></label>
                            <input asp-for="Quantity" class="form-control" type="number"
                                   min="1" max="@Math.Min(product.StockQuantity, 100)" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Add to cart</button>
                    </form>
                }
                else
                {
                    <button type="button" class="btn btn-secondary w-100" disabled>Not available</button>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
